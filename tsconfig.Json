{
    "compilerOptions": {
      "target": "es2017",
      "lib": ["DOM", "DOM.Iterable", "ES2017"],
      "jsx": "react-jsx",
      "module": "ESNext",
      "moduleResolution": "Node",
       "resolveJsonModule": true,
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
      
   
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "build"]
  }
  